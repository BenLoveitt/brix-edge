<?xml version="1.0" encoding="utf-8"?>
<!--
  brix-edge on IIS — the site's whole configuration, in one reviewable file.

  This site serves ONE thing: a station's released drawing, at
      /drawings/<screen id>/
  where each <screen id> is an IIS virtual directory pointing at a folder in
  your drawings tree (Install-BrixEdgeIIS.ps1 creates them from stations.json).
  IIS itself provides everything the screen needs and nothing more:

    - the default document is released.pdf and ONLY released.pdf
    - directory browsing is off: a folder is never listed to a client
    - request filtering allows GET and HEAD, and .pdf (plus the extensionless
      folder URL that resolves to it); every other verb and extension is refused
    - the static file handler is the only handler: no scripts, no modules
    - Cache-Control: no-store, so a proxy never keeps a superseded drawing
    - ETag + Last-Modified come from the file, and IIS answers a matching
      If-None-Match / If-Modified-Since with 304 — the screen's minute check

  Nothing here runs code from Brix. The record of every read is your IIS log.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="released.pdf" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <handlers accessPolicy="Read">
      <clear />
      <add name="StaticFile" path="*" verb="GET,HEAD" modules="StaticFileModule,DefaultDocumentModule" resourceType="Either" requireAccess="Read" />
    </handlers>

    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".pdf" />
      <mimeMap fileExtension=".pdf" mimeType="application/pdf" />
    </staticContent>

    <security>
      <requestFiltering allowDoubleEscaping="false" removeServerHeader="true">
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
        </verbs>
        <fileExtensions allowUnlisted="false">
          <!-- "." is IIS's name for "no extension": the folder URL /drawings/<id>/ -->
          <add fileExtension="." allowed="true" />
          <add fileExtension=".pdf" allowed="true" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="web.config" />
        </hiddenSegments>
        <!-- A drawing larger than this is refused. The screen has the same 32 MiB cap. -->
        <requestLimits maxAllowedContentLength="33554432" maxUrl="512" maxQueryString="0" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <clear />
      <!-- Plain, empty error bodies (a zero-byte file the installer creates in
           the site root): no server details, no listings. File mode reads the
           file directly and does not pass through request filtering. -->
      <error statusCode="403" path="empty.txt" responseMode="File" />
      <error statusCode="404" path="empty.txt" responseMode="File" />
      <error statusCode="405" path="empty.txt" responseMode="File" />
    </httpErrors>
  </system.webServer>
</configuration>
